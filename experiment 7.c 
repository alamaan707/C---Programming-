#include <stdio.h>

#define MAX_SIZE 100

int main(void) {
    int array[MAX_SIZE];
    int count, i, sum = 0, maximum, minimum;
    float average;

    printf("How many elements (1-%d)? ", MAX_SIZE);
    if (scanf("%d", &count) != 1 || count < 1 || count > MAX_SIZE) {
        printf("Invalid array size.\n");
        return 1;
    }

    printf("Enter %d integers:\n", count);
    for (i = 0; i < count; i++) {
        if (scanf("%d", &array[i]) != 1) {
            printf("Invalid input.\n");
            return 1;
        }
        sum += array[i];
    }

    maximum = minimum = array[0];
    for (i = 1; i < count; i++)
    {
        if (array[i] > maximum) {
            maximum = array[i];
        }
        if (array[i] < minimum) {
            minimum = array[i];
        }
    }

    average = (float)sum / count;

    printf("\nSum: %d\n", sum);
    printf("Average: %.2f\n", average);
    printf("Maximum: %d\n", maximum);
    printf("Minimum: %d\n", minimum);

    printf("Reversed array: ");
    for (i = count - 1; i >= 0; i--) {
        printf("%d ", array[i]);
    }
    printf("\n");
     return 0;
}
