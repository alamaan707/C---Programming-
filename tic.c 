#include <stdio.h>

int main() {

    int a[9] = {1,2,3,4,5,6,7,8,9};
    int n, i;
    int player = 10;

    for(i = 0; i < 9; i++) {

        printf("\n%d | %d | %d\n", a[0], a[1], a[2]);
        printf("---|---|---\n");
        printf("%d | %d | %d\n", a[3], a[4], a[5]);
        printf("---|---|---\n");
        printf("%d | %d | %d\n", a[6], a[7], a[8]);

        printf("\nPlayer %d, enter position: ", player);

        scanf("%d", &n);

        if(n < 1 || n > 9 || a[n-1] > 9) {
            printf("Invalid position!\n");
            i--;
            continue;
        }

        a[n-1] = player;

        if(player == 10)
            player = 11;
        else
            player = 10;
    }

    printf("\nGame Over!");

    return 0;
}